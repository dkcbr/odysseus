{
  "name": "tradingview",
  "version": "1.0.0",
  "description": "Odysseus-native TradingView MCP server",
  "tools": [
    {
      "name": "ping",
      "description": "Ping the TradingView MCP server",
      "input_schema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        },
        "required": ["message"]
      }
    },
    {
      "name": "get_chart",
      "description": "Fetch TradingView chart data for a symbol",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "interval": { "type": "string", "default": "1h" }
        },
        "required": ["symbol"]
      }
    },
    {
      "name": "get_indicators",
      "description": "Fetch TradingView indicators for a symbol",
      "input_schema": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "indicators": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["symbol", "indicators"]
      }
    }
  ]
}
